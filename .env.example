# Default mode is a complete local demonstration. No real order is created.
MCD_MODE=demo
HOST=127.0.0.1
PORT=3001
MCD_LEDGER_PATH=server/data/orders.json

# For live mode, use the official endpoint, token and supplied verified mapping.
# Do not prefix these secrets with VITE_. Never commit your .env file.
# MCD_MODE=live
# MCD_MCP_URL=https://mcp.mcd.cn
# MCD_MCP_TOKEN=
# MCD_MCP_MAPPING_PATH=server/mcp.mapping.json
# Optional background restaurant search. The game has no restaurant picker.
# MCD_STORE_CITY=上海
# MCD_STORE_KEYWORD=人民广场
